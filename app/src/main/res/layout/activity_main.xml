<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cortex_bg">

    <!-- Main Terminal Interface -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- One tab for each session (colors are set from the terminal's color scheme, see MainActivity.applyChrome) -->
        <org.cortex.terminal.view.SessionTabsView
            android:id="@+id/sessionTabs"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/cortex_surface_container" />

        <View
            android:id="@+id/tabsDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cortex_outline_variant" />

        <!-- Terminal Display Surface -->
        <org.cortex.terminal.view.TerminalView
            android:id="@+id/terminalView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Dock Divider -->
        <View
            android:id="@+id/dockDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/cortex_outline_variant" />

        <!-- Bottom Bar: Virtual Keys Toolbar & Terminal Search Bar with Slide Animation -->
        <FrameLayout
            android:id="@+id/bottomBarContainer"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:background="@color/cortex_surface_container">

            <!-- 2-Row Extra Keys Keyboard Toolbar -->
            <org.cortex.terminal.view.ExtraKeysView
                android:id="@+id/extraKeysView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Terminal Search Bar (slides in from right over/replacing extra keys) -->
            <org.cortex.terminal.view.TerminalSearchBar
                android:id="@+id/searchBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

    <!-- Left drawer: the sessions and the app's actions -->
    <LinearLayout
        android:id="@+id/navDrawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:orientation="vertical"
        android:background="@color/cortex_surface_container"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Header: the name of the app, the update check and the settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="20dp"
            android:paddingEnd="10dp">

            <TextView
                android:id="@+id/drawerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name"
                android:textColor="@color/cortex_text_primary"
                android:textStyle="bold"
                android:textSize="18sp" />

            <ImageView
                android:id="@+id/btnDrawerFiles"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:src="@drawable/ic_folder"
                android:contentDescription="@string/files_title"
                android:background="@drawable/icon_circle_bg" />

            <ImageView
                android:id="@+id/btnDrawerSettings"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:padding="11dp"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings"
                android:background="@drawable/icon_circle_bg" />
        </LinearLayout>

        <View
            android:id="@+id/drawerDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@color/cortex_outline_variant" />

        <TextView
            android:id="@+id/drawerSessionsLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="22dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp"
            android:text="@string/drawer_sessions"
            android:textAllCaps="false"
            android:textColor="@color/cortex_text_muted"
            android:textSize="12sp" />

        <!-- Active Sessions List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/sessionRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false" />

        <!-- Drawer Bottom Actions: KEYBOARD and NEW SESSION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/btnDrawerKeyboard"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:gravity="center"
                android:text="@string/drawer_keyboard"
                android:textColor="@color/cortex_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/icon_circle_bg" />

            <TextView
                android:id="@+id/btnDrawerNewSession"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1.25"
                android:layout_marginStart="6dp"
                android:gravity="center"
                android:text="@string/drawer_new_session"
                android:textColor="@color/cortex_bg"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/icon_circle_bg" />
        </LinearLayout>

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
