<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/pref_cat_appearance">
        <ListPreference
            app:defaultValue="jetbrains_mono"
            app:entries="@array/terminal_font_entries"
            app:entryValues="@array/terminal_font_values"
            app:key="terminal_font"
            app:title="@string/pref_font_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="catppuccin"
            app:entries="@array/terminal_theme_entries"
            app:entryValues="@array/terminal_theme_values"
            app:key="terminal_theme"
            app:title="@string/pref_theme_title"
            app:useSimpleSummaryProvider="true" />

        <ListPreference
            app:defaultValue="11"
            app:entries="@array/font_size_entries"
            app:entryValues="@array/font_size_values"
            app:key="terminal_font_size"
            app:title="@string/pref_font_size_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="show_session_tabs"
            app:summary="@string/pref_session_tabs_summary"
            app:title="@string/pref_session_tabs_title" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="keep_screen_on"
            app:summary="@string/pref_keep_screen_on_summary"
            app:title="@string/pref_keep_screen_on_title" />

        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="secure_screen"
            app:summary="@string/pref_secure_screen_summary"
            app:title="@string/pref_secure_screen_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_sessions">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="restore_sessions"
            app:summary="@string/pref_restore_sessions_summary"
            app:title="@string/pref_restore_sessions_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_remote">
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_language">
        <ListPreference
            app:defaultValue="system"
            app:entries="@array/language_entries"
            app:entryValues="@array/language_values"
            app:key="app_language"
            app:title="@string/pref_language_title"
            app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_notifications">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="notify_long_commands"
            app:summary="@string/pref_notify_summary"
            app:title="@string/pref_notify_title" />

        <ListPreference
            app:defaultValue="30"
            app:dependency="notify_long_commands"
            app:entries="@array/long_command_threshold_entries"
            app:entryValues="@array/long_command_threshold_values"
            app:key="long_command_threshold"
            app:title="@string/pref_notify_threshold_title"
            app:useSimpleSummaryProvider="true" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="allow_osc52"
            app:summary="@string/pref_clipboard_summary"
            app:title="@string/pref_clipboard_title" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="notify_servers"
            app:summary="@string/pref_servers_summary"
            app:title="@string/pref_servers_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_files">
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="shared_folder_access"
            app:persistent="false"
            app:summary="@string/pref_shared_folder_access_summary"
            app:title="@string/pref_shared_folder_access_title" />
    </PreferenceCategory>


    <PreferenceCategory app:key="linux_system_category" app:title="@string/pref_cat_debian">
        <EditTextPreference
            app:defaultValue=""
            app:dialogTitle="@string/pref_linux_user_title"
            app:key="linux_user"
            android:inputType="textNoSuggestions"
            app:summary="@string/pref_linux_user_summary"
            app:title="@string/pref_linux_user_title" />
        <SwitchPreferenceCompat
            app:defaultValue="false"
            app:key="proot_diagnostics"
            app:summary="@string/pref_proot_diagnostics_summary"
            app:title="@string/pref_proot_diagnostics_title" />
        <Preference app:key="view_proot_log" app:summary="@string/pref_view_proot_log_summary" app:title="@string/pref_view_proot_log_title" />
        <Preference app:key="clear_proot_log" app:title="@string/pref_clear_proot_log_title" />
        <Preference app:key="failsafe_session" app:summary="@string/pref_failsafe_summary" app:title="@string/pref_failsafe_title" />
        <Preference app:key="backup_debian" app:summary="@string/pref_backup_debian_summary" app:title="@string/pref_backup_debian_title" />
        <Preference app:key="restore_debian" app:summary="@string/pref_restore_debian_summary" app:title="@string/pref_restore_debian_title" />
        <Preference app:key="reset_debian" app:summary="@string/pref_reset_debian_summary" app:title="@string/pref_reset_debian_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_terminal">
        <Preference app:key="edit_extra_keys" app:title="@string/pref_extra_keys_title" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/pref_cat_support">
        <Preference
            app:key="about_miauterm"
            app:summary="@string/pref_about_summary"
            app:title="@string/pref_about_title" />
        <Preference
            app:key="bug_report"
            app:summary="@string/pref_bug_report_summary"
            app:title="@string/pref_bug_report_title" />
    </PreferenceCategory>

</PreferenceScreen>
