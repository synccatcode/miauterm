#!/bin/bash

usage() {
    printf 'Usage: miauterm-cmd run <command> [argument ...]\n'
    printf '       miauterm-cmd --help\n'
    printf 'Commands: info battery notification notification-remove clipboard-get clipboard-set\n'
    printf '          toast vibrate open share tts wakelock network keysreload\n'
}

fail() {
    printf 'miauterm-cmd: %s\n' "$*" >&2
    exit 2
}

invoked_as="${0##*/}"
if [ "$invoked_as" = "notify-send" ]; then
    if [ "$#" -eq 1 ] && [ "$1" = "--help" ]; then
        printf 'Usage: notify-send <summary> [body]\n'
        exit 0
    fi
    [ "$#" -ge 1 ] || fail "usage: notify-send <summary> [body]"
    title="$1"
    content=""
    if [ "$#" -ge 2 ]; then
        content="$2"
    fi
    [ "$#" -le 2 ] || fail "notify-send accepts a summary and optional body"
    set -- run notification -t "$title" -c "$content"
fi

if [ "$#" -eq 1 ] && [ "$1" = "--help" ]; then
    usage
    exit 0
fi
[ "$#" -ge 2 ] && [ "$1" = "run" ] || fail "usage: miauterm-cmd run <command> [argument ...]"
shift
command="$1"
shift
[[ "$command" =~ ^[a-z][a-z0-9-]*$ ]] || fail "invalid command name"

config="${MIAUTERM_CMD_CONFIG:-/run/miauterm-cmd/connection}"
[ -r "$config" ] || fail "the Miauterm app command service is not available"
read -r port token < "$config" || fail "cannot read the app command connection"
[[ "$port" =~ ^[0-9]{1,5}$ ]] || fail "invalid app command connection"
(( 10#$port > 0 && 10#$port <= 65535 )) || fail "invalid app command connection"
[[ "$token" =~ ^[0-9a-f]{64}$ ]] || fail "invalid app command connection"

stdin_file=""
stdin_length=-1
if [ ! -t 0 ]; then
    stdin_file="$(mktemp "${TMPDIR:-/tmp}/miauterm-cmd.XXXXXX")" ||
        fail "cannot create a temporary input file"
    trap 'rm -f -- "$stdin_file"' EXIT
    cat > "$stdin_file" || fail "cannot read standard input"
    stdin_length="$(wc -c < "$stdin_file")" || fail "cannot measure standard input"
fi

if ! exec 3<>"/dev/tcp/127.0.0.1/$port"; then
    fail "cannot connect to the Miauterm app command service"
fi

{
    printf 'MIAUTERM-CMD 1\n%s\n%s\n%s\n' "$token" "$command" "$#"
    for argument in "$@"; do
        byte_count="$(printf '%s' "$argument" | wc -c)" || exit 1
        printf '%s\n' "$byte_count"
        printf '%s' "$argument"
    done
    if [ "$stdin_length" -lt 0 ]; then
        printf '%s\n' -1
    else
        printf '%s\n' "$stdin_length"
        cat "$stdin_file"
    fi
} >&3 || fail "could not send the app command"

IFS= read -r status <&3 || fail "the Miauterm app command service did not respond"
[[ "$status" =~ ^[0-9]+$ ]] || fail "invalid response from the Miauterm app command service"
cat <&3
exit "$status"
